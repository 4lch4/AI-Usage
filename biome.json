{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      ".github/**/*.yml",
      ".github/**/*.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "bracketSameLine": true,
    "bracketSpacing": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "quoteProperties": "asNeeded",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedPackageJson": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "!packages/core/src/node/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**", "bun", "bun:*"],
                    "message": "The core outside src/node runs on Android too. Put Node and Bun code in src/node."
                  },
                  {
                    "group": ["**/node/**", "./node/*"],
                    "message": "Neutral core must not import from src/node."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Bun": "The core outside src/node runs on Android too. Put Bun code in src/node.",
                  "process": "The core outside src/node runs on Android too. Inject what you need instead."
                }
              }
            }
          }
        }
      }
    }
  ]
}
