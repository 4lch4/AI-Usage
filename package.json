{
  "name": "ai-usage",
  "version": "0.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:4lch4/AI-Usage.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "cd apps/windows && bun run build",
    "check": "biome ci .",
    "dev": "cd apps/windows && bun run dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "probe": "cd apps/windows && bun run probe",
    "start": "cd apps/windows && bun run start",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/android"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
