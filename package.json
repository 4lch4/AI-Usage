{
  "name": "ai-usage",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:4lch4/AI-Usage.git"
  },
  "type": "module",
  "scripts": {
    "build": "electrobun build --env=stable",
    "check": "biome ci .",
    "dev": "electrobun dev --watch",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "prepare": "husky",
    "probe": "bun run src/cli.ts",
    "start": "electrobun dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "electrobun": "2.0.3-beta.11",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
